# Copy to .env (git-ignored; never commit it). Values come from your Entra tenant and SharePoint site; see notes.md.

# --- API (local entra mode and CDK) ---
MCSHEETY_TENANT_ID=
MCSHEETY_API_CLIENT_ID=
# Short scope name exposed by the API registration
MCSHEETY_API_SCOPE=access_as_user
# Local development only. Deployed stacks read the credential from Secrets Manager instead.
MCSHEETY_CLIENT_SECRET=
# Complete ARN (with the 6-character suffix) of the Secrets Manager secret, for CDK
MCSHEETY_CREDENTIAL_SECRET_ARN=
# SharePoint workbook (from Graph discovery; do not use /me/drive paths)
MCSHEETY_DRIVE_ID=
MCSHEETY_ITEM_ID=
MCSHEETY_POLICY_MODE=co-located
# Trusted attributes for row policies (JSON). Example maps the Entra "department" property:
# MCSHEETY_ATTRIBUTES={"source":"graph","properties":{"departmentId":"department"},"valueMaps":{"departmentId":{"Operations":"dept-ops","Engineering":"dept-eng","Finance":"dept-fin"}}}
MCSHEETY_ATTRIBUTES=
# Comma-separated browser origins for CORS (CDK)
MCSHEETY_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite exposes only VITE_-prefixed values to the browser; never put secrets here) ---
VITE_MCSHEETY_API_URL=http://localhost:3000
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SPA_CLIENT_ID=
VITE_MCSHEETY_API_SCOPE=api://<MCSHEETY_API_CLIENT_ID>/access_as_user
# Set to 1 to use the local demo API (no Entra)
VITE_MCSHEETY_DEMO=
